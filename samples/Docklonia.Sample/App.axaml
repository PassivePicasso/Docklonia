<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="https://github.com/docklonia"
             xmlns:vm="using:Docklonia.Sample.ViewModels"
             x:Class="Docklonia.Sample.App"
             RequestedThemeVariant="Default">

  <Application.Resources>

    <!--
      A descriptor set authored once and assigned to a Dock by name. The
      descriptors hold unevaluated bindings and no per-Dock state, so one
      instance may serve any number of Docks (§3.7).
    -->
    <dock:DockItemDescriptors x:Key="WorkspaceDescriptors">
      <dock:DockItemDescriptor DataType="vm:CodeDocument"
                               Title="{Binding FileName}"
                               ContentKey="{Binding FullPath}"
                               CanClose="{Binding IsClosable}" />
      <dock:DockItemDescriptor DataType="vm:TerminalPane"
                               Title="{Binding SessionName}"
                               ContentKey="{Binding SessionId}" />
      <dock:DockItemDescriptor DataType="vm:InspectorViewModel"
                               Title="Inspector"
                               ContentKey="Inspector" />
      <dock:DockItemDescriptor DataType="vm:OutlineViewModel"
                               Title="Outline"
                               ContentKey="Outline" />
    </dock:DockItemDescriptors>

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- The single theme include (§1). Nothing else is registered. -->
    <StyleInclude Source="avares://Docklonia/Themes/Docklonia.axaml" />

    <!--
      The other delivery route: a class confers the set, so `Classes="tools"`
      declares a Dock a tool area. Declaring no CodeDocument is what refuses
      documents there (§3.7).
    -->
    <Style Selector="dock|Dock.tools">
      <Setter Property="ItemDescriptors">
        <dock:DockItemDescriptors>
          <dock:DockItemDescriptor DataType="vm:TerminalPane"
                                   Title="{Binding SessionName}"
                                   ContentKey="{Binding SessionId}" />
          <dock:DockItemDescriptor DataType="vm:OutlineViewModel"
                                   Title="Outline"
                                   ContentKey="Outline" />
        </dock:DockItemDescriptors>
      </Setter>
    </Style>
  </Application.Styles>

  <Application.DataTemplates>

    <!--
      Ordinary templates for this application's own view-model types, exactly as
      they would be written without the docking library (§3.8). None of them
      mentions a Docklonia type, and none carries title or close metadata — that
      comes from the descriptors instead.
    -->

    <DataTemplate DataType="vm:CodeDocument">
      <TextBox Text="{Binding Text}"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Code,Consolas,monospace"
               BorderThickness="0" />
    </DataTemplate>

    <DataTemplate DataType="vm:TerminalPane">
      <ItemsControl ItemsSource="{Binding Lines}" Margin="8"
                    FontFamily="Cascadia Code,Consolas,monospace" />
    </DataTemplate>

    <DataTemplate DataType="vm:InspectorViewModel">
      <StackPanel Margin="10" Spacing="6">
        <TextBlock Text="Inspector" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Selection}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:OutlineViewModel">
      <ItemsControl ItemsSource="{Binding Symbols}" Margin="10" />
    </DataTemplate>

    <!-- Contributed menu entries are the application's own command objects. -->
    <DataTemplate DataType="vm:ContextAction">
      <TextBlock Text="{Binding Title}" />
    </DataTemplate>

  </Application.DataTemplates>

</Application>
