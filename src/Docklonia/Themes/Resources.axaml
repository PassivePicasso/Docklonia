<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Unleash.Theme">

  <!--
    Theme resource keys are public API (§12). An application restyles by
    overriding these in its own resources rather than replacing whole templates,
    so they carry the same stability commitment as a method signature. Each key
    reads a theme token, so the docks follow the host's scheme and density.
  -->

  <ResourceDictionary.MergedDictionaries>
    <theme:ComponentTokens>
      <theme:ComponentToken Key="DockBackground" Token="Theme.Surface" />
      <theme:ComponentToken Key="DockPaneBackground" Token="Theme.Surface" />
      <theme:ComponentToken Key="DockPaneBorderBrush" Token="Theme.Border" />
      <theme:ComponentToken Key="DockTitleBarBackground" Token="Theme.Surface.Raised" />
      <theme:ComponentToken Key="DockTitleBarActiveBackground" Token="Theme.Selection" />
      <theme:ComponentToken Key="DockTitleForeground" Token="Theme.Text" />
      <theme:ComponentToken Key="DockTabBackground" Token="Theme.Surface.Raised" />
      <theme:ComponentToken Key="DockTabHoverBackground" Token="Theme.Selection" />
      <theme:ComponentToken Key="DockTabSelectedBackground" Token="Theme.Surface" />
      <theme:ComponentToken Key="DockTabActiveAccent" Token="Theme.Accent" />
      <theme:ComponentToken Key="DockTabForeground" Token="Theme.Text" />

      <!-- The splitter reads as the gap it sits in until it is grabbed. -->
      <theme:ComponentToken Key="DockSplitterBrush" Token="Theme.Surface" />
      <theme:ComponentToken Key="DockSplitterHoverBrush" Token="Theme.Accent" />

      <theme:ComponentToken Key="DockGuideBackground" Token="Theme.Surface.Raised" />
      <theme:ComponentToken Key="DockGuideBorderBrush" Token="Theme.Border" />
      <theme:ComponentToken Key="DockGuideHotBackground" Token="Theme.Accent" />
      <theme:ComponentToken Key="DockGuideGlyphBrush" Token="Theme.Accent" />
      <theme:ComponentToken Key="DockGuideHotGlyphBrush" Token="Theme.Surface" />
      <theme:ComponentToken Key="DockDropPreviewBrush" Token="Theme.Selection" />
      <theme:ComponentToken Key="DockDropPreviewBorderBrush" Token="Theme.Accent" />
      <theme:ComponentToken Key="DockGhostBackground" Token="Theme.Surface.Raised" />

      <!-- Metrics. Also public API. -->
      <theme:ComponentToken Key="DockPaneBorderThickness" Token="Theme.Stroke" />
      <theme:ComponentToken Key="DockTabPadding" Token="Theme.Control.Padding" />
      <theme:ComponentToken Key="DockTabCornerRadius" Token="Theme.Radius" />
      <theme:ComponentToken Key="DockGuideCornerRadius" Token="Theme.Radius" />
      <theme:ComponentToken Key="DockSplitterThickness" Token="Theme.Space.Gap" />
      <theme:ComponentToken Key="DockTitleBarHeight" Token="Theme.Control.Height" />
      <theme:ComponentToken Key="DockAutoHideStripThickness" Token="Theme.Control.Height" />
      <theme:ComponentToken Key="DockChromeFontSize" Token="Theme.Type.Small" />
      <theme:ComponentToken Key="DockIconSize" Token="Theme.Icon.Size" />
      <theme:ComponentToken Key="DockGuideBorderThickness" Token="Theme.Stroke" />
      <theme:ComponentToken Key="DockGhostBorderThickness" Token="Theme.Stroke" />
      <theme:ComponentToken Key="DockGhostCornerRadius" Token="Theme.Radius" />
      <theme:ComponentToken Key="DockGhostPadding" Token="Theme.Control.Padding" />
      <theme:ComponentToken Key="DockDropPreviewBorderThickness" Token="Theme.Stroke.Focus" />
    </theme:ComponentTokens>
  </ResourceDictionary.MergedDictionaries>

  <!-- How wide a tab may grow or shrink: layout bounds no token holds. -->
  <x:Double x:Key="DockTabMaxWidth">240</x:Double>
  <x:Double x:Key="DockTabMinWidth">48</x:Double>

</ResourceDictionary>
