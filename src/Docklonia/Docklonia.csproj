<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Docklonia</RootNamespace>
    <AssemblyName>Docklonia</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Docklonia</PackageId>
    <Version>0.3.6</Version>
    <PackageOutputPath>F:\Projects\Godot\NuGetFeed</PackageOutputPath>
    <Description>A docking-layout library for Avalonia: split panes, tabbed groups, floating windows, drag-and-drop re-docking, and a JSON-serializable layout.</Description>
    <Authors>James LaPenn</Authors>
    <Copyright>Copyright (c) 2026 James LaPenn</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>avalonia;docking;dock;layout;mvvm;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**\*.axaml" />
  </ItemGroup>

</Project>
